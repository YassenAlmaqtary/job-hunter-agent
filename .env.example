# Copy to .env and fill in values.
# docker compose loads .env from the project directory for variable substitution.

# --- PostgreSQL + authentication ---
# Local Streamlit (host) + postgres container: use localhost
# Docker app service overrides this automatically to host `postgres`
DATABASE_URL=postgresql://jobhunter:jobhunter_secret@localhost:5432/jobhunter
# POSTGRES_USER=jobhunter
# POSTGRES_PASSWORD=jobhunter_secret
# POSTGRES_DB=jobhunter
# POSTGRES_PORT=5432
# AUTH_SESSION_HOURS=168
# AUTH_DISABLED=false

# --- Google Sign-In (OAuth 2.0) ---
# 1) Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# 2) Authorized redirect URI = exact public app URL, e.g. https://jopagent.deliciousdemo.site/
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/

# --- LLM / search ---
# openai | gemini | grok | groq — يُستخدم في الواجهة كافتراضي عند أول فتح
# DEFAULT_LLM_PROVIDER=openai

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini (LangChain يقرأ GOOGLE_API_KEY أو GEMINI_API_KEY)
GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# xAI Grok (OpenAI-compatible API)
XAI_API_KEY=
# XAI_MODEL=grok-2-latest

# Groq
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

TAVILY_API_KEY=
# Optional: enables Google Jobs aggregation (can include LinkedIn/Indeed/Glassdoor listings)
# SERPAPI_API_KEY=
# Optional demo fallback jobs (disabled by default to keep real sources only)
# USE_SEED_JOBS=false

# --- Optional: LangSmith observability & evaluation ---
# Get API key: https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-hunter-agent
# لا تضع LANGCHAIN_TRACING_V2=false مع LANGSMITH_TRACING=true (يعطّل التتبع)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=

# --- Ports (optional overrides) ---
# STREAMLIT_PORT=8501
# REDIS_HOST_PORT=6379
# IMAGE_TAG=latest

# --- LangGraph checkpointing ---
# Default: in-memory. For Redis (start stack with --profile with-redis):
# REDIS_URL=redis://redis:6379/0
# LANGGRAPH_CHECKPOINTER_BACKEND=redis
REDIS_URL=
LANGGRAPH_CHECKPOINTER_BACKEND=memory
